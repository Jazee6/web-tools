{
  "ci": {
    "collect": {
      "staticDistDir": "dist/client",
      "url": [
        "http://localhost/index.html",
        "http://localhost/developer.html",
        "http://localhost/json-formatter.html",
        "http://localhost/merge-pdf.html",
        "http://localhost/speech-to-text.html",
        "http://localhost/video-converter/mov-to-mp4.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": ["performance"],
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "error",
          { "maxNumericValue": 2000, "aggregationMethod": "median" }
        ],
        "cumulative-layout-shift": [
          "error",
          { "maxNumericValue": 0.05, "aggregationMethod": "median" }
        ],
        "total-blocking-time": ["error", { "maxNumericValue": 150, "aggregationMethod": "median" }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci/report" }
  }
}
