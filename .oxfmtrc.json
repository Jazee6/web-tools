{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "astro": true,
  "sortImports": true,
  "sortPackageJson": true,
  "sortTailwindcss": {
    "stylesheet": "./src/styles/global.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": [
    "src/paraglide/",
    "worker-configuration.d.ts",
    "bun.lock",
    ".astro/",
    "dist/",
    "dist-on-demand/",
    "docs/",
    "/*.md"
  ]
}
