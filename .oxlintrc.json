{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "src/paraglide/**",
    "worker-configuration.d.ts",
    ".astro/**",
    "dist/**",
    "src/components/ui/**"
  ],
  "rules": {
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ],
    "react/react-in-jsx-scope": "off"
  }
}
