---
import type { GetStaticPaths } from "astro";
import { SearchIcon } from "lucide-react";

import Backdrop from "@/components/pages/Backdrop.astro";
import CategoryNav from "@/components/pages/CategoryNav.astro";
import { categoryIcons } from "@/components/pages/icons";
import ToolGrid from "@/components/pages/ToolGrid";
import { Button } from "@/components/ui/button";
import { Kbd } from "@/components/ui/kbd";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCatalog, homeStatuses, toolsInCategory } from "@/lib/catalog";
import { defaultLocale, hreflang, localizePath, locales } from "@/lib/i18n/locales";
import { alternates, isIndexable } from "@/lib/seo/indexing";
import { websiteJsonLd } from "@/lib/seo/json-ld";
import { m } from "@/paraglide/messages";

export const getStaticPaths = (() =>
  locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }))) satisfies GetStaticPaths;

const { locale } = Astro.props;
const catalog = await getCatalog();
const sections = catalog.categories
  .filter((category) => category.entries[locale])
  .map((category) => ({
    id: category.id,
    icon: categoryIcons[category.id],
    name: category.entries[locale]!.data.name,
    intro: category.entries[locale]!.data.intro,
    path: localizePath(locale, category.path),
    tools: toolsInCategory(catalog, category.id, locale).map((tool) => ({
      id: tool.id,
      name: tool.entries[locale]!.data.name,
      path: localizePath(locale, tool.path),
    })),
  }));
---

<BaseLayout
  wide
  title={`${m.home_title()} | ${m.site_name()}`}
  description={m.home_description()}
  indexable={isIndexable(homeStatuses, locale)}
  alternates={alternates(homeStatuses, locale, "/")}
  jsonLd={websiteJsonLd({
    name: m.site_name(),
    description: m.home_description(),
    path: localizePath(locale),
    lang: hreflang[locale],
  })}
>
  <main>
    <section class="relative isolate overflow-hidden border-b">
      <Backdrop />
      <div class="mx-auto flex max-w-5xl flex-col items-center gap-6 px-4 pt-20 pb-16 text-center sm:pt-28 sm:pb-20">
        <h1 class="max-w-3xl bg-linear-to-b from-foreground to-foreground/65 bg-clip-text pb-1 text-4xl font-semibold tracking-tighter text-balance text-transparent sm:text-6xl">
          {m.home_title()}
        </h1>
        <p class="max-w-2xl text-lg text-pretty text-muted-foreground">{m.home_description()}</p>
        {/* 和 header 的搜索按钮共用同一个 ⌘K 对话框（SiteHeader 的脚本绑定 data-search-open） */}
        <Button
          variant="outline"
          size="xl"
          className="mt-2 w-full max-w-md justify-start font-normal text-muted-foreground shadow-sm"
          data-search-open
        >
          <SearchIcon />
          {m.search_placeholder()}
          <Kbd className="ml-auto hidden md:inline-flex">⌘K</Kbd>
        </Button>
        <CategoryNav
          class="justify-center"
          items={sections.map((section) => ({
            id: section.id,
            name: section.name,
            href: `#${section.id}`,
            icon: section.icon,
            count: section.tools.length,
          }))}
        />
      </div>
    </section>

    <div class="mx-auto flex max-w-5xl flex-col gap-16 px-4 py-16 sm:gap-24 sm:py-24">
      {sections.map((section) => (
        <section
          id={section.id}
          class="grid scroll-mt-8 gap-6 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-12"
        >
          <div class="flex flex-col items-start gap-4 md:sticky md:top-22 md:self-start">
            <div class="flex size-12 items-center justify-center rounded-2xl bg-primary text-primary-foreground shadow-sm">
              <section.icon className="size-6" />
            </div>
            <h2 class="text-2xl font-semibold tracking-tight">
              <a href={section.path} class="underline-offset-4 hover:underline">
                {section.name}
              </a>
            </h2>
            <p class="text-sm text-pretty text-muted-foreground">{section.intro}</p>
          </div>
          <ToolGrid tools={section.tools} />
        </section>
      ))}
    </div>
  </main>
</BaseLayout>
