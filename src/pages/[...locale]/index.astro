---
import type { GetStaticPaths } from "astro";

import BaseLayout from "@/layouts/BaseLayout.astro";
import { defaultLocale, locales } from "@/lib/i18n/locales";
import { m } from "@/paraglide/messages";

export const getStaticPaths = (() =>
  locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
  }))) satisfies GetStaticPaths;
---

<BaseLayout title={`${m.home_title()} | ${m.site_name()}`} description={m.home_description()}>
  <main class="mx-auto flex max-w-3xl flex-col gap-4 px-4 py-16">
    <h1 class="text-3xl font-semibold tracking-tight">{m.home_title()}</h1>
    <p class="text-muted-foreground">{m.home_description()}</p>
  </main>
</BaseLayout>
