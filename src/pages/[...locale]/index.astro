---
import type { GetStaticPaths } from "astro";

import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCatalog, homeStatuses, toolsInCategory } from "@/lib/catalog";
import { defaultLocale, hreflang, localizePath, locales } from "@/lib/i18n/locales";
import { alternates, isIndexable } from "@/lib/seo/indexing";
import { websiteJsonLd } from "@/lib/seo/json-ld";
import { m } from "@/paraglide/messages";

export const getStaticPaths = (() =>
  locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }))) satisfies GetStaticPaths;

const { locale } = Astro.props;
const catalog = await getCatalog();
const sections = catalog.categories
  .filter((category) => category.entries[locale])
  .map((category) => ({
    name: category.entries[locale]!.data.name,
    path: localizePath(locale, category.path),
    tools: toolsInCategory(catalog, category.id, locale).map((tool) => ({
      name: tool.entries[locale]!.data.name,
      path: localizePath(locale, tool.path),
    })),
  }));
---

<BaseLayout
  title={`${m.home_title()} | ${m.site_name()}`}
  description={m.home_description()}
  indexable={isIndexable(homeStatuses, locale)}
  alternates={alternates(homeStatuses, locale, "/")}
  jsonLd={websiteJsonLd({
    name: m.site_name(),
    description: m.home_description(),
    path: localizePath(locale),
    lang: hreflang[locale],
  })}
>
  <main class="typeset mx-auto max-w-3xl px-4 py-16">
    <h1>{m.home_title()}</h1>
    <p>{m.home_description()}</p>
    {sections.map((section) => (
      <>
        <h2>
          <a href={section.path}>{section.name}</a>
        </h2>
        <ul>
          {section.tools.map((tool) => (
            <li>
              <a href={tool.path}>{tool.name}</a>
            </li>
          ))}
        </ul>
      </>
    ))}
  </main>
</BaseLayout>
