---
import OutputTable from "@/components/tool/OutputTable";
import { loadTool } from "@/components/tool/tool-loader";
import ToolIsland from "@/components/tool/ToolIsland";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { hreflang } from "@/lib/i18n/locales";
import type { VariantPageData } from "@/lib/variant-page";

import FaqList from "./FaqList.astro";
import PageUpdated from "./PageUpdated.astro";
import { serverProps } from "./tool-island";
import ToolGrid from "./ToolGrid";
import ToolHero from "./ToolHero.astro";
import ToolStage from "./ToolStage.astro";
import ToolSteps from "./ToolSteps.astro";

// 只依赖 VariantPageData，不读 Content Collections：on-demand 模式下 Worker 从 JSON 渲染同一个组件（ADR-0004）
interface Props {
  data: VariantPageData;
}

const { data } = Astro.props;

// island 服务端渲染需要同步拿到 Tool（见 tool-loader.ts）。Variant 没有自己的 Agent Interface，不注册 WebMCP
const tool = await loadTool(data.toolId);
const server = serverProps(tool);

const updated = new Intl.DateTimeFormat(hreflang[data.locale], { dateStyle: "long" }).format(
  new Date(data.updated),
);
---

<BaseLayout
  title={data.head.title}
  description={data.head.description}
  indexable={data.head.indexable}
  alternates={data.head.alternates}
  ogImage={data.head.ogImage}
  markdown={data.head.markdown}
  jsonLd={data.head.jsonLd}
>
  <main class="pb-16 sm:pb-24">
    <ToolHero crumbs={data.crumbs} toolId={data.toolId} name={data.name} answer={data.answer} />
    <ToolStage wide={tool.form?.split}>
      <ToolIsland
        client:load
        toolId={data.toolId}
        strings={data.island.strings}
        server={server}
        variant={data.island.variant}
      />
    </ToolStage>

    <div class="mx-auto flex max-w-3xl flex-col gap-16 px-4 pt-16 sm:pt-20">
      <ToolSteps steps={data.steps} />

      {/* 独有数据（architecture §11 门槛 2）：静态渲染的 Data Table，不水合 */}
      <section class="flex flex-col gap-6">
        <h2 class="text-2xl font-semibold tracking-tight">{data.table.caption}</h2>
        <OutputTable
          rows={data.table.rows}
          columns={data.table.columns}
          labels={data.table.labels}
          cellVariant="prose"
        />
      </section>

      <div class="typeset empty:hidden">
        <Fragment set:html={data.html} />
      </div>

      <FaqList faq={data.faq} />

      <section class="flex flex-col gap-6">
        <h2 class="text-2xl font-semibold tracking-tight">{data.more.heading}</h2>
        {/* 链接都是同一个 Tool 和它的 Variant，共用 Tool 的图标 */}
        <ToolGrid tools={data.more.links.map((link) => ({ ...link, id: data.toolId }))} />
      </section>

      <PageUpdated date={updated} datetime={data.updated} />
    </div>
  </main>
</BaseLayout>
