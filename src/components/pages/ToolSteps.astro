---
import { m } from "@/paraglide/messages";

interface Props {
  steps: string[];
}

const { steps } = Astro.props;
---

<section class="flex flex-col gap-6">
  <h2 class="text-2xl font-semibold tracking-tight">{m.tool_steps()}</h2>
  <ol class="flex flex-col gap-5">
    {steps.map((step, index) => (
      <li class="flex gap-4">
        <span
          aria-hidden="true"
          class="flex size-7 shrink-0 items-center justify-center rounded-full border bg-background text-sm font-medium tabular-nums shadow-xs"
        >
          {index + 1}
        </span>
        <p class="pt-0.5 text-pretty">{step}</p>
      </li>
    ))}
  </ol>
</section>
