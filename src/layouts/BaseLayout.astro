---
import "@/styles/global.css";
import SiteHeader from "@/components/site/SiteHeader.astro";
import { defaultLocale, hreflang, isLocale } from "@/lib/i18n/locales";
import type { Alternate } from "@/lib/seo/indexing";
import { serializeJsonLd } from "@/lib/seo/json-ld";
import { canonicalPath } from "@/lib/url";
import { m } from "@/paraglide/messages";

interface Props {
  title: string;
  description: string;
  // Draft 内容（或 en 仍是 Draft）输出 noindex，且不带 hreflang（ADR-0007）
  indexable: boolean;
  alternates?: Alternate[];
  jsonLd?: unknown[];
  ogImage?: string;
  // 页面的 .md 副本路径
  markdown?: string;
}

const {
  title,
  description,
  indexable,
  alternates = [],
  jsonLd = [],
  ogImage,
  markdown,
} = Astro.props;
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const canonical = new URL(canonicalPath(Astro.url.pathname), Astro.site);
---

<!doctype html>
<html lang={hreflang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex" />}
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.hreflang}
        href={new URL(alternate.path, Astro.site)}
      />
    ))}
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={m.site_name()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={hreflang[locale]} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    {jsonLd.map((data) => (
      <script is:inline type="application/ld+json" set:html={serializeJsonLd(data)} />
    ))}
  </head>
  <body class="min-h-svh bg-background text-foreground antialiased">
    <SiteHeader />
    <slot />
  </body>
</html>
