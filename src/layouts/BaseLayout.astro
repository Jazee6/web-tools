---
import "@/styles/global.css";
import SiteFooter from "@/components/site/SiteFooter.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";
import { defaultLocale, hreflang, isLocale, localizePath } from "@/lib/i18n/locales";
import type { Alternate } from "@/lib/seo/indexing";
import { serializeJsonLd } from "@/lib/seo/json-ld";
import { canonicalPath } from "@/lib/url";
import { m } from "@/paraglide/messages";

interface Props {
  title: string;
  description: string;
  // Draft 内容（或 en 仍是 Draft）输出 noindex，且不带 hreflang（ADR-0007）
  indexable: boolean;
  alternates?: Alternate[];
  jsonLd?: unknown[];
  ogImage?: string;
  // 页面的 .md 副本路径
  markdown?: string;
}

const {
  title,
  description,
  indexable,
  alternates = [],
  jsonLd = [],
  ogImage,
  markdown,
} = Astro.props;
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const canonical = new URL(canonicalPath(Astro.url.pathname), Astro.site);

// 注册 Service Worker（src/sw.ts）。第一次访问时，SW 接管之前（以及接管时还在路上）的请求都没经过它
// （workerStart 为 0），由页面把这些资源和当前 URL 报给 SW 补缓存，这样用过一次就能离线打开。
const registerServiceWorker = `if ("serviceWorker" in navigator) {
  const sw = navigator.serviceWorker;
  if (!sw.controller) {
    const page = location.href.split("#")[0];
    new PerformanceObserver((list) => {
      const resources = list.getEntries().filter((entry) => !entry.workerStart).map((entry) => entry.name);
      if (resources.length === 0) return;
      sw.ready.then((registration) =>
        registration.active?.postMessage({ type: "cache", page, resources }),
      );
    }).observe({ type: "resource", buffered: true });
  }
  addEventListener("load", () => void sw.register("/sw.js").catch(() => {}));
}`;
---

<!doctype html>
<html lang={hreflang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href={localizePath(locale, "/manifest.webmanifest")} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex" />}
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.hreflang}
        href={new URL(alternate.path, Astro.site)}
      />
    ))}
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={m.site_name()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={hreflang[locale]} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    {jsonLd.map((data) => (
      <script is:inline type="application/ld+json" set:html={serializeJsonLd(data)} />
    ))}
    {/* 只在生产构建注册，dev 和 HMR 不受影响 */}
    {import.meta.env.PROD && <script is:inline set:html={registerServiceWorker} />}
  </head>
  <body class="flex min-h-svh flex-col bg-background text-foreground antialiased">
    <SiteHeader />
    <div class="flex-1">
      <slot />
    </div>
    <SiteFooter />
    <script>
      import { installErrorReporting } from "@/lib/telemetry/client";

      installErrorReporting();
    </script>
  </body>
</html>
